# AgentLink Server Environment Configuration
PORT=3000
PORTAL_URL=http://localhost:3000
BRAND_NAME=AgentLink
ADMIN_EMAIL=admin@test.local
ADMIN_PASSWORD=change-me-in-production

# Authentication Configuration (Optional)
# In production, specify GOOGLE_CLIENT_ID to enforce Google GIS authentication
GOOGLE_CLIENT_ID=
# Comma-separated list of SHA256 hashes of authorized human email addresses
AUTHORIZED_EMAIL_HASHES=

# Cloudflare Zero Trust Tunnel (Optional - for remote edge access)
CLOUDFLARE_TUNNEL_TOKEN=
